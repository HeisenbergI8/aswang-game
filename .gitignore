# Roblox place files — binary, huge, and merge-hostile.
# Your MAP lives in Studio and in Roblox's cloud place-version history.
# Publish regularly; that is your map backup, not Git.
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Generated by Luau LSP for type resolution
sourcemap.json

# Build output. Anchored with a leading slash so it matches ONLY the repo root —
# an unanchored `build/` also swallows .claude/skills/build/, silently and with
# nothing in `git status` to tell you the skill was never committed.
/build/
*.rbxm
*.rbxmx

# Roblox API type definitions, fetched by `npm run check:toolchain`.
# ~1MB, regenerated whenever Roblox ships an API change — a build input, not source.
.luau-defs/

# macOS
.DS_Store
